# Copy this file to .env.local and fill in your real values.
# .env.local is already in .gitignore — never commit real keys.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The two below are used ONLY by Supabase Edge Functions (Deno), never by
# the Next.js frontend. Set them as Edge Function secrets (README Step 5),
# not here.
# SUPABASE_SERVICE_ROLE_KEY=
# (Edge Functions also auto-receive SUPABASE_URL)

# Resend (resend.com) — for email alerts
# RESEND_API_KEY=

# Twilio (twilio.com) — sandbox is fine for the demo
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
